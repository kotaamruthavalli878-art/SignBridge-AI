# ==========================================
# SignBridge AI — Environment Variable Checklist
# ==========================================

# Backend Configuration (server/.env)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database URI (Optional for local dev - has resilient memory fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/signbridge?retryWrites=true&w=majority

# JWT Authentication Secret Key (Required for signing tokens)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Google Gemini API Key (Optional for local dev - has graceful deterministic fallback)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Frontend Configuration (client/.env)
VITE_API_URL=http://localhost:5000/api
